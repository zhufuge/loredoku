# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public base URL used to build file access URLs
PUBLIC_BASE_URL=http://localhost:3000

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=murdoku

# ---- Uploads ----
# Absolute or relative path; defaults to packages/server/storage/uploads
UPLOAD_ROOT=./storage/uploads

# ---- Web (Vite) ----
VITE_API_BASE_URL=http://localhost:3000/api
