# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Public base URL used to build file access URLs
# 换后端端口时必须与 PORT 保持一致（头像 / 物品图 / 地图封面都用它拼 URL）
PUBLIC_BASE_URL=http://localhost:3000

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=loredoku

# ---- Uploads ----
# Absolute or relative path; defaults to packages/server/storage/uploads
UPLOAD_ROOT=./storage/uploads

# ---- Web (Vite) ----
# 可选。留空 / 注释掉时前端走同源 `/api`，由 Vite 代理转发到后端，
# 后端地址由 VITE_PROXY_TARGET 决定（`npm run dev -s <port>` 会自动注入）。
# 仅当要把前端直连某个绝对地址时才需要显式写死。
# VITE_API_BASE_URL=http://localhost:3000/api

# ---- Dev 启动参数（DEV-H12）----
# npm run dev                         # 后端 3000 + 前端 5173（默认）
# npm run dev -- --server-port 4000   # 后端 4000，前端 5173
# npm run dev -- -w 5180              # 前端 5180，后端 3000
# npm run dev -- -s 4000 -w 5180      # 两个都自定义
# 传参优先于 .env：命令行给的端口会覆盖 PORT / PUBLIC_BASE_URL。
