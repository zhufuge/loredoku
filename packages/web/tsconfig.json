{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@murdoku/shared": ["../shared/src/index.ts"],
      "@murdoku/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
