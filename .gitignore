# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# vitest 用 ts 配置时生成的临时产物
*.timestamp-*.mjs

# env
.env
.env.local
.env.*.local

# logs
*.log
npm-debug.log*

# uploads (keep folder, ignore content)
packages/server/storage/uploads/**
!packages/server/storage/uploads/.gitkeep
!packages/server/storage/uploads/cards/

# 字体源文件（几十 MB 的 TTF/OTF）：由 npm run fonts 裁成 src/assets/fonts/ 里的 woff2，
# 仓库只收裁好的那一份
packages/web/fonts-source/*.ttf
packages/web/fonts-source/*.otf

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# docs
docs/sessions/
.workbuddy/
