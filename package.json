{
  "name": "loredoku",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "格物（loredoku）一款推理数独类游戏，包含游戏编辑工坊 — monorepo（shared / server / web）",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace @loredoku/server --",
    "dev:web": "npm run dev --workspace @loredoku/web --",
    "dev:player": "npm run dev:player --workspace @loredoku/web --",
    "build": "npm run build --workspaces --if-present",
    "build:player": "npm run build:player --workspace @loredoku/web --",
    "preview:player": "npm run preview:player --workspace @loredoku/web --",
    "start": "npm run start --workspace @loredoku/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && vitest run scripts",
    "db:migrate": "npm run db:migrate --workspace @loredoku/server",
    "db:rollback": "npm run db:rollback --workspace @loredoku/server",
    "db:migrate:make": "npm run db:migrate:make --workspace @loredoku/server"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.1.2",
    "jsdom": "25.0.1",
    "supertest": "7.0.0",
    "vitest": "2.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
